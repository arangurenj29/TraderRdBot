# Create API credentials at https://my.telegram.org and keep them private.
TELEGRAM_API_ID=replace_with_your_api_id
TELEGRAM_API_HASH=replace_with_your_api_hash

# Source coordinates from https://t.me/c/2180632014/231508/231906
TELEGRAM_SOURCE_CHAT_ID=2180632014
TELEGRAM_SOURCE_TOPIC_ID=231508
TELEGRAM_SOURCE_SEED_MESSAGE_ID=231906

# Optional numeric peer ID. Derive it with `traderrd inspect-source`.
# TELEGRAM_EXPECTED_SENDER_ID=replace_with_numeric_sender_id

# Both the session and database paths are excluded from Git.
TELEGRAM_SESSION_PATH=.local/traderrd
TRADERRD_DB_PATH=data/traderrd.sqlite3
LOG_LEVEL=INFO

# Public Bybit V5 market data only. No Bybit credentials are used.
BYBIT_PUBLIC_BASE_URL=https://api.bybit.com
BYBIT_CATEGORY=linear
BYBIT_TIMEOUT_SECONDS=3.0

# Demo Trading private execution only. Create a dedicated Demo key without
# withdrawal access. Mainnet and testnet keys are intentionally unsupported.
# Never print these values.
BYBIT_DEMO_BASE_URL=https://api-demo.bybit.com
BYBIT_DEMO_API_KEY=replace_with_demo_api_key
BYBIT_DEMO_API_SECRET=replace_with_demo_api_secret
BYBIT_DEMO_RECV_WINDOW_MS=5000
BYBIT_DEMO_TIMEOUT_SECONDS=5.0
BYBIT_DEMO_READ_RETRIES=2
