# Copy to .env.server on the server. Keep this file private and untracked.
# Persistent Telegram session and SQLite state are stored in the Docker volume
# mounted at /var/lib/traderrd; do not delete that volume during updates.
TRADERRD_DB_PATH=/var/lib/traderrd/traderrd.sqlite3
TELEGRAM_SESSION_PATH=/var/lib/traderrd/traderrd
LOG_LEVEL=INFO

# Telegram application credentials (https://my.telegram.org).
TELEGRAM_API_ID=replace_with_your_api_id
TELEGRAM_API_HASH=replace_with_your_api_hash
TELEGRAM_SOURCE_CHAT_ID=2180632014
TELEGRAM_SOURCE_TOPIC_ID=231508
TELEGRAM_SOURCE_SEED_MESSAGE_ID=231906
TELEGRAM_EXPECTED_SENDER_ID=8003985182

# Public market data is HTTPS and linear only.
BYBIT_PUBLIC_BASE_URL=https://api.bybit.com
BYBIT_CATEGORY=linear
BYBIT_TIMEOUT_SECONDS=3.0

# Dedicated Bybit Demo Trading credentials only. Mainnet and testnet are unsupported.
BYBIT_DEMO_BASE_URL=https://api-demo.bybit.com
BYBIT_DEMO_API_KEY=replace_with_demo_api_key
BYBIT_DEMO_API_SECRET=replace_with_demo_api_secret
BYBIT_DEMO_RECV_WINDOW_MS=5000
BYBIT_DEMO_TIMEOUT_SECONDS=5.0
BYBIT_DEMO_READ_RETRIES=2
